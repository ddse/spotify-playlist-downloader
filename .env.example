MUSIC_DIR=/srv/dev-disk-by-uuid-CHANGE/Music
TZ=Asia/Tokyo
WEB_PORT=8088
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in Spotify Developer Dashboard.
SPOTIFY_REDIRECT_URI=http://192.168.10.20:8088/api/spotify/callback
SYNC_TOKEN=change-this-to-a-long-random-secret
SYNC_INTERVAL_MINUTES=30
AUDIO_FORMAT=mp3
AUDIO_BITRATE=320k
