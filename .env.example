MUSIC_DIR=/srv/dev-disk-by-uuid-CHANGE/Music
TZ=Asia/Tokyo
WEB_PORT=8088
METUBE_PORT=8081
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in Spotify Developer Dashboard.
# Example: http://192.168.10.20:8088/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://192.168.10.20:8088/api/spotify/callback
SYNC_INTERVAL_MINUTES=30
AUDIO_FORMAT=mp3
AUDIO_BITRATE=320k
