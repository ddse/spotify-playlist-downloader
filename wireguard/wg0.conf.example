# Copy this file to wireguard/wg0.conf and replace the placeholders.
# Do NOT commit wg0.conf because it contains a private key.
#
# For an ASUS WireGuard server, obtain these values from the client peer
# configuration generated by the router.

[Interface]
PrivateKey = <CLIENT_PRIVATE_KEY>
Address = 10.192.2.10/24

[Peer]
PublicKey = <ASUS_WIREGUARD_SERVER_PUBLIC_KEY>
AllowedIPs = 0.0.0.0/0
Endpoint = <YOUR_ASUS_DDNS_OR_PUBLIC_IP>:<WIREGUARD_PORT>
PersistentKeepalive = 25
